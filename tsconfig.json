{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023"
    ],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "paths": {
      "claude-code/testing": [
        "./bun/kit.ts"
      ]
    }
  },
  "include": [
    "vendor",
    "hooks",
    "tests",
    "bun"
  ],
  "exclude": [
    "tests/*.kit.ts"
  ]
}
